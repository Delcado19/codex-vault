<Window x:Class="WindowsSecretManager.App.SecretDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Vault" Icon="Assets/codex-vault-selected.ico" Width="680" MinWidth="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#0B0D14" Foreground="#F4F6FC">
 <Grid Margin="26,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock x:Name="HeadingText" Foreground="#F4F6FC" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="DescriptionText" Margin="0,6,0,0" Foreground="#A9B0C2"/></StackPanel>
  <StackPanel Grid.Row="1"><TextBlock x:Name="NameLabel" Foreground="#F4F6FC" FontWeight="SemiBold"/><TextBox x:Name="NameBox" Margin="0,7,0,16" Height="38"/></StackPanel>
  <StackPanel Grid.Row="2"><TextBlock x:Name="ValueLabel" Foreground="#F4F6FC" FontWeight="SemiBold"/><PasswordBox x:Name="ValueBox" Margin="0,7,0,9" Height="38" MaxLength="2560"/><TextBlock x:Name="PrivacyText" Foreground="#A9B0C2" FontSize="12" Margin="0,0,0,22"/></StackPanel>
  <Border Grid.Row="3" Background="#2A2115" BorderBrush="#594522" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,20"><StackPanel Orientation="Horizontal"><TextBlock Foreground="#F3C969" FontSize="16" Text="⚠" Margin="0,0,9,0"/><TextBlock x:Name="ClipboardWarningText" Foreground="#E5C98B" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" MinWidth="92" IsCancel="True"/><Button x:Name="SaveButton" MinWidth="126" Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
